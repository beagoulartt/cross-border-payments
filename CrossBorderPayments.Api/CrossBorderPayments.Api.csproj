<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
  </ItemGroup>

  <Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <FrontendPath>$(MSBuildProjectDirectory)/../cross-border-payments-client</FrontendPath>
      <FrontendBuildPath>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)frontend</FrontendBuildPath>
    </PropertyGroup>
    <ItemGroup>
      <FrontendSource Include="$(FrontendPath)/**/*"
        Exclude="$(FrontendPath)/node_modules/**/*;$(FrontendPath)/dist/**/*;$(FrontendPath)/.*/**/*;$(FrontendPath)/.env*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendSource)"
      DestinationFiles="@(FrontendSource->'$(FrontendBuildPath)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Exec WorkingDirectory="$(FrontendBuildPath)" Command="npm ci" />
    <Exec WorkingDirectory="$(FrontendBuildPath)" Command="npm run build" />
    <ItemGroup>
      <FrontendFiles Include="$(FrontendBuildPath)/dist/**/*" />
      <ResolvedFileToPublish Include="@(FrontendFiles)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
